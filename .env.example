# ============================================
# Sparfuchs Berlin — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
#
# Production deployment:
#   API + Web → Vercel   (single project; API runs as a serverless function,
#                          see api/[[...route]].ts and vercel.json)
#   Set DATABASE_URL / REDIS_URL / CORS_ORIGINS in Vercel project settings
#   under Environment Variables — the serverless function reads them at
#   runtime, they are NOT picked up from this file in production.

# ============================================
# DATABASE (any managed Postgres — connection string must be reachable
# from Vercel's serverless functions, i.e. a public host + SSL)
# ============================================
# DATABASE_URL_DIRECT is used by Drizzle Kit (bypasses PgBouncer pooling).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sparfuchs
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/sparfuchs

# ============================================
# REDIS (any managed Redis, or omit — the API degrades gracefully when
# Redis is unavailable, everything just falls back to hitting the DB)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# DATA PIPELINE — REWE (Pepesto API)
# ============================================
# Sign up at https://pepesto.com to get a key.
PEPESTO_API_KEY=your_pepesto_api_key_here
PEPESTO_BASE_URL=https://api.pepesto.com

# ============================================
# DATA PIPELINE — Lidl (Apify)
# ============================================
# Sign up at https://apify.com and get a token from
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here
APIFY_LIDL_ACTOR_ID=easyapi/lidl-product-scraper

# ============================================
# APPLICATION SERVER
# ============================================
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed CORS origins.
# Production example: CORS_ORIGINS=https://sparfuchs-berlin.de
CORS_ORIGINS=http://localhost:5173

# ============================================
# FRONTEND (Vite build-time env vars)
# ============================================
# Local dev only — points at the standalone dev server (pnpm --filter
# @sparfuchs/api dev). In production, leave VITE_API_URL UNSET: the frontend
# defaults to the relative path "/api/v1", which Vercel rewrites to the
# api/[[...route]].ts function on the same domain (see vercel.json).
VITE_API_URL=http://localhost:3001/api/v1

# ============================================
# PIPELINE SCHEDULE (cron syntax, Europe/Berlin TZ)
# ============================================
PIPELINE_CRON_REWE=0 5 * * *
PIPELINE_CRON_LIDL=30 5 * * *

# ============================================
# RATE LIMITING
# ============================================
# Maximum requests per IP per minute (default: 100)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# ============================================
# MONITORING (optional)
# ============================================
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# LOG_LEVEL=info

# ============================================
# GITHUB ACTIONS — DEPLOYMENT SECRETS
# ============================================
# Set these in GitHub → Settings → Secrets → Actions (not in .env):
#   DATABASE_URL          Production Postgres connection string (for the
#                          migration step that runs before each deploy)
#   VERCEL_TOKEN           Vercel API token
#   VERCEL_ORG_ID          Vercel organization/team ID
#   VERCEL_PROJECT_ID      Vercel project ID
